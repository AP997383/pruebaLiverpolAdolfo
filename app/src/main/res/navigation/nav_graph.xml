<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/productListFragment">

    <fragment
        android:id="@+id/productListFragment"
        android:name="com.example.mobiletechnicaltest.ui.plp.ProductListFragment"
        android:label="@string/plp_title"
        tools:layout="@layout/fragment_product_list"
        xmlns:tools="http://schemas.android.com/tools">

        <action
            android:id="@+id/action_productListFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.mobiletechnicaltest.ui.pdp.ProductDetailFragment"
        android:label="@string/pdp_title"
        tools:layout="@layout/fragment_product_detail"
        xmlns:tools="http://schemas.android.com/tools">

        <argument
            android:name="productId"
            app:argType="integer" />
    </fragment>

</navigation>
